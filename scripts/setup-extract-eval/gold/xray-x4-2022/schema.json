    { "key": "front_caster", "label": "Front caster — three checkboxes above the bushing icons map left-to-right to 5° / 4° / 3°; answer with the degree number of the box containing the X", "section": "Front & rear suspension", "valueType": "choice", "options": ["5", "4", "3"] },
    { "key": "rear_caster", "label": "Rear caster — six checkboxes above the bushing icons map left-to-right to 0.5° / 1.5° / 2.5° / 3.5° / 4.5° / 5.5°; answer with the degree number of the box containing the X", "section": "Front & rear suspension", "valueType": "choice", "options": ["0.5", "1.5", "2.5", "3.5", "4.5", "5.5"] },
