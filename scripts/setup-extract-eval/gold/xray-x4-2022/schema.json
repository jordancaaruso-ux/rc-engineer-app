    { "key": "motor", "label": "Motor", "section": "Electronics & body", "valueType": "text" },
    { "key": "motor_timing", "label": "Timing", "section": "Electronics & body", "valueType": "text" },
    { "key": "esc", "label": "ESC", "section": "Electronics & body", "valueType": "text" },
    { "key": "batteries", "label": "Batteries", "section": "Electronics & body", "valueType": "text" },
    { "key": "body", "label": "Body", "section": "Electronics & body", "valueType": "text" },
    { "key": "wing", "label": "Wing", "section": "Electronics & body", "valueType": "text" },
    { "key": "body_height_front", "label": "Body position: dimension from body post to window bottom line (mm)", "section": "Electronics & body", "valueType": "text" },
