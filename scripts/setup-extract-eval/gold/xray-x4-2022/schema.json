    { "key": "rear_shock_position", "label": "Rear shock position — diagonal row of 4 small circles labeled 1-4 (1 = lowest/leftmost); exactly one is filled solid red (if none filled, answer empty). Report that number", "section": "Rear suspension", "valueType": "choice", "options": ["1", "2", "3", "4"] },
    { "key": "driveshaft_rear", "label": "Drive shaft rear length", "section": "Rear suspension", "valueType": "choice", "options": ["52mm", "54mm"] },
    { "key": "driveshaft_rear_type", "label": "Drive shaft rear type", "section": "Rear suspension", "valueType": "choice", "options": ["std", "bearing"] },
    { "key": "downstop_rear", "label": "Downstop rear (mm)", "section": "Rear suspension", "valueType": "text" },
    { "key": "rear_hub", "label": "Rear hub", "section": "Rear suspension", "valueType": "choice", "options": ["composite", "alu"] },
    { "key": "rear_hub_shim", "label": "Rear hub shim (mm, right of rear hub)", "section": "Rear suspension", "valueType": "text" },

    { "key": "toe_out_front", "label": "Toe out front (degrees)", "section": "Top view", "valueType": "text" },
    { "key": "toe_in_rear", "label": "Toe in rear (degrees)", "section": "Top view", "valueType": "text" },
    { "key": "ackermann_shim", "label": "Ackermann shim (mm)", "section": "Top view", "valueType": "text" },
    { "key": "diff_position_front", "label": "Diff position front", "section": "Top view", "valueType": "choice", "options": ["up", "down"] },
    { "key": "diff_position_rear", "label": "Diff position rear", "section": "Top view", "valueType": "choice", "options": ["up", "down"] },
    { "key": "upper_arm_front", "label": "Upper arm front (standard checked?)", "section": "Top view", "valueType": "choice", "options": ["standard", "other"] },
    { "key": "upper_arm_rear", "label": "Upper arm rear (standard checked?)", "section": "Top view", "valueType": "choice", "options": ["standard", "other"] },
    { "key": "steering_bridge", "label": "Steering bridge (yes/no)", "section": "Top view", "valueType": "choice", "options": ["yes", "no"] },
    { "key": "top_deck_flex", "label": "Top deck flex", "section": "Top view", "valueType": "choice", "options": ["none", "bearing"] },
    { "key": "top_deck_thickness", "label": "Top deck thickness", "section": "Top view", "valueType": "choice", "options": ["1.6mm", "2.0mm"] },
    { "key": "offset_front", "label": "Offset front", "section": "Top view", "valueType": "choice", "options": ["standard", "-0.5mm"] },
    { "key": "offset_rear", "label": "Offset rear", "section": "Top view", "valueType": "choice", "options": ["standard", "-0.5mm"] },
    { "key": "top_deck_splitted", "label": "Top deck splitted (checkbox)", "section": "Top view", "valueType": "choice", "options": ["yes", "no"] },

    { "key": "steering_lock", "label": "Steer. lock (degrees)", "section": "Bottom view", "valueType": "text" },
    { "key": "steering_shim", "label": "Steer. shim size (mm)", "section": "Bottom view", "valueType": "text" },
    { "key": "chassis", "label": "Chassis", "section": "Bottom view", "valueType": "choice", "options": ["graphite", "alu", "alu flex"] },
    { "key": "t_brace", "label": "T-brace", "section": "Bottom view", "valueType": "choice", "options": ["alu", "brass"] },
    { "key": "front_arms", "label": "Front arms", "section": "Bottom view", "valueType": "choice", "options": ["medium", "hard"] },
    { "key": "rear_arms", "label": "Rear arms", "section": "Bottom view", "valueType": "choice", "options": ["medium", "hard"] },
    { "key": "steering_plate", "label": "Steer. plate", "section": "Bottom view", "valueType": "choice", "options": ["standard", "+1mm"] },

    { "key": "comments", "label": "Comments", "section": "Comments", "valueType": "text" }
