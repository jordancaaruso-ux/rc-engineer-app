    { "key": "body_stop_front_height", "label": "Body stop height (mm)", "section": "Front suspension", "valueType": "text" },
    { "key": "front_brace", "label": "Front brace (front suspension diagram, yes/no)", "section": "Front suspension", "valueType": "choice", "options": ["yes", "no"] },
    { "key": "bulkhead_shims", "label": "Bulkhead shims — three boxes in one row: YES [box] 3mm [box] NO; the first box (right of YES) means yes, the second (between 3mm and NO) means no. Report the checked option", "section": "Front suspension", "valueType": "choice", "options": ["yes", "3mm", "no"] },
    { "key": "front_shock_position", "label": "Front shock position — diagonal row of 4 small circles labeled 1-4 (1 = lowest/leftmost); exactly one is filled solid red. Report that number", "section": "Front suspension", "valueType": "choice", "options": ["1", "2", "3", "4"] },
    { "key": "driveshaft_front", "label": "Drive shaft front length", "section": "Front suspension", "valueType": "choice", "options": ["58mm", "59mm"] },
    { "key": "driveshaft_front_type", "label": "Drive shaft front type", "section": "Front suspension", "valueType": "choice", "options": ["std", "bearing"] },
    { "key": "downstop_front", "label": "Downstop front (mm)", "section": "Front suspension", "valueType": "text" },
    { "key": "front_hub", "label": "Front hub", "section": "Front suspension", "valueType": "choice", "options": ["composite", "alu"] },

    { "key": "camber_rear", "label": "Camber rear (degrees)", "section": "Rear suspension", "valueType": "text" },
