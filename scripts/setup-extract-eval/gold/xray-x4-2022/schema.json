    { "key": "fr_susp_shim", "label": "Shim (mm, next to height)", "section": "Front & rear suspension", "valueType": "text" },
    { "key": "toe_gain", "label": "Toe gain (mm)", "section": "Front & rear suspension", "valueType": "text" },
