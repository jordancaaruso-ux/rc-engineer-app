    { "key": "shim_fr", "label": "FR shim (mm, front ride height block)", "section": "Front & rear suspension", "valueType": "text" },
    { "key": "shim_rf", "label": "RF shim (mm, rear ride height block)", "section": "Front & rear suspension", "valueType": "text" },
    { "key": "shim_rr", "label": "RR shim (mm, rear ride height block)", "section": "Front & rear suspension", "valueType": "text" },
