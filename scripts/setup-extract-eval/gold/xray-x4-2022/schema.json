  "fields": [
    { "key": "race", "label": "Race", "section": "Header", "valueType": "text" },
    { "key": "track", "label": "Track", "section": "Header", "valueType": "text" },
    { "key": "driver_name", "label": "Name", "section": "Header", "valueType": "text" },
    { "key": "date", "label": "Date", "section": "Header", "valueType": "text" },
    { "key": "track_temperature", "label": "Track temperature", "section": "Header", "valueType": "text" },
    { "key": "qual_position", "label": "Qual position", "section": "Header", "valueType": "text" },
