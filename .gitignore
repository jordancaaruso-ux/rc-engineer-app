.next/
.env
.env.local
prisma/dev.db

# Cursor local state / debug (but keep project rules tracked — they're persistent guidance).
.cursor/*
!.cursor/rules/

# TypeScript incremental cache
*.tsbuildinfo

# Local agent debug NDJSON (Cursor / dev sessions)
debug-*.log

# Local dev PDFs (Blob in production). Outside `public/` so they are not traced into serverless bundles.
.local-uploads/
video-analysis/.venv/
video-analysis/**/__pycache__/
# Legacy dev path — keep out of repo/deploy; migrate files to `.local-uploads/` if needed (same filenames).
public/uploads/

# Capacitor / Xcode (keep project; ignore local build artifacts)
ios/App/build/
ios/DerivedData/
*.xcuserstate
hardware/rc-pwm-logger/.history/

# Claude Code machine-local permissions (shared settings.json IS committed)
.claude/settings.local.json

# Setup extraction eval — raw model outputs (regenerated each run)
scripts/setup-extract-eval/results/
perf-lighthouse-*.json

# Throwaway one-off scripts + data dumps at repo root (never part of the app)
/scratch-*

# Python bytecode from the hardware carrier-board scripts
hardware/**/__pycache__/

.vercel
.env*
