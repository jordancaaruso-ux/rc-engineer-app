// Migration history reset for Postgres deployment.
// SQLite migrations removed. Fresh baseline will be generated after
// provider switch in next step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stripeCustomerId String? @unique

  /**
   * Last IANA zone seen from this user's device (the `rc_tz` cookie, refreshed on run
   * create). Session grouping needs to know what day a run was to the person who DROVE
   * it, and runs logged before per-run capture have no zone of their own — this is the
   * fallback for those. See `Run.localTimeZone`.
   */
  timeZone String?

  accounts Account[]
  sessions Session[]
  subscription Subscription?

  cars            Car[]
  runs            Run[]
  tracks          Track[]
  trackLayouts    TrackLayout[]
  tireSets        TireSet[]
  tireTypesCreated TireType[] @relation("TireTypeCreatedBy")
  additiveTypesCreated AdditiveType[] @relation("AdditiveTypeCreatedBy")
  batteries       Battery[]
  snapshots       SetupSnapshot[]
  events          Event[]
  eventParticipations EventParticipation[]
  favouriteTracks FavouriteTrack[]
  trackLocationRunPromptDismissals TrackLocationRunPromptDismissal[]
  appSettings     AppSetting[]
  actionItems     ActionItem[]
  setupDocuments  SetupDocument[]
  setupCalibrations SetupSheetCalibration[]
  setupSheetModels  SetupSheetModel[]
  setupImportBatches SetupImportBatch[]
  importedLapTimeSessions ImportedLapTimeSession[]
  watchedLapSources WatchedLapSource[]
  pushSubscriptions PushSubscription[]
  nativePushDevices NativePushDevice[]
  videoAssets     VideoAsset[]
  trackCameraProfiles TrackCameraProfile[]
  videoAnalysisJobs   VideoAnalysisJob[]
  engineerBetweenRunHints EngineerBetweenRunHint[]
  engineerDashboardSuggestions EngineerDashboardSuggestion[]
  engineerChatThreads EngineerChatThread[]
  engineerMessageRatings EngineerMessageRating[]
  engineerGoldSetCandidates EngineerGoldSetCandidate[]

  teamMemberships TeamMembership[]
  teamsCreated    Team[]           @relation("TeamsCreated")
  teamRunComments TeamRunComment[] @relation("TeamRunCommentAuthor")
  teamInvitesReceived TeamInvite[] @relation("TeamInvitesReceived")
  teamInvitesSent     TeamInvite[] @relation("TeamInvitesSent")
  aiUsageDaily    AiUsageDaily[]
  chassisTypeRequests ChassisTypeRequest[]
  baselineSetupsCreated BaselineSetup[] @relation("BaselineSetupCreatedBy")
  setupFillDrafts SetupFillDraft[]
  setupSheetBlanksUploaded SetupSheetBlank[] @relation("SetupSheetBlankUploader")
}

/**
 * Paid subscription (Stripe). One row per user; the webhook (`/api/stripe/webhook`) is the source
 * of truth. `tier` is our internal label ("standard" | "pro") mapped from the Stripe price.
 * Entitlement is DERIVED server-side in `src/lib/entitlement.ts` — never trust the client.
 */
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String    @unique
  stripeCustomerId     String
  status               String
  tier                 String
  priceId              String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  seats                Int       @default(1)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

/** Processed Stripe webhook event ids — dedupe so retried/replayed events stay idempotent. */
model StripeWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}

/**
 * Per-user AI spend ledger, rolled up by day and feature.
 *
 * Exists because `checkApiRateLimit` is in-memory per serverless instance — on Vercel its real
 * ceiling is limit x instance count, i.e. none. This table is the durable cap: one atomic
 * increment per AI call, one indexed read to enforce.
 *
 * Rollup, not per-call rows, so the table stays small; per-call forensics live in the OpenAI
 * dashboard. `day` is the calendar day in the app time zone, not UTC midnight.
 */
model AiUsageDaily {
  id      String   @id @default(cuid())
  userId  String
  day     DateTime @db.Date
  /** `engineer-chat` \| `engineer-quick-fix` \| `setup-extract` */
  feature String

  calls            Int   @default(0)
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  costUsd          Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, feature])
  @@index([userId, day])
}

/**
 * A driver asked for a chassis type that isn't in the catalog. Chassis creation is admin-only
 * (curated ground truth), so without this the request evaporated into a 403 and the founder never
 * heard about it — the loop `ASSET_ACCESS_NORTH_STAR.md` calls for.
 */
model ChassisTypeRequest {
  id            String    @id @default(cuid())
  userId        String
  requestedName String
  /** Normalized name — dedupes repeat asks for the same chassis. */
  normalizedName String
  requestCount  Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([resolvedAt, createdAt])
}

/** Named group for mutual visibility pilot (members share runs in Engineer + team Sessions view). */
model Team {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String

  createdByUserId String?
  createdBy       User? @relation("TeamsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  memberships TeamMembership[]
  runComments TeamRunComment[]
  invites     TeamInvite[]
}

/**
 * Consent gate for joining a team. A `TeamMembership` row is the grant itself â€” mutual, retroactive
 * over the member's whole history â€” so it must never be created by anyone but the invited user.
 * Deliberately a separate model rather than a `status` column on `TeamMembership`: no membership row
 * exists until the invitee accepts, so every query that reads memberships is fail-safe by
 * construction instead of one forgotten `where: { status }` away from leaking a whole run history.
 *
 * One row per (team, user) for all time â€” a re-invite after a decline resets this row to `pending`.
 */
model TeamInvite {
  id     String @id @default(cuid())
  teamId String
  /** Existing `User` who was invited; they are the only account that may accept or decline. */
  invitedUserId String
  /** Admin who sent it, for the "<name> invited you" push. Kept if they later leave the team. */
  invitedByUserId String?
  /** Role granted on accept â€” `admin` \| `member`. */
  role String @default("member")
  /** `pending` \| `accepted` \| `declined` \| `revoked` â€” see `src/lib/teams/teamInviteRules.ts`. */
  status String @default("pending")

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User  @relation("TeamInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User? @relation("TeamInvitesSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, invitedUserId])
  @@index([invitedUserId, status])
  @@index([teamId, status])
}

model TeamMembership {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())
  teamId   String
  userId   String
  /** `admin` \| `member` â€” pilot uses `member` for everyone unless you promote in DB. */
  role     String   @default("member")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

/**
 * A comment on a teammate's run, as seen in that team's delta feed.
 *
 * Anchored to (run, team): the same run appears in the feed of every team its owner belongs to,
 * and those conversations stay separate — what you say to your club mates does not reach the
 * factory squad. `parentId` gives ONE level of replies (threads, not trees); a reply's parent
 * must be a root comment on the same (runId, teamId), enforced in `src/lib/teams/commentRules.ts`.
 *
 * There is no standalone posting: a comment only ever hangs off a run in the feed.
 */
model TeamRunComment {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /** Author deleted their own comment: body blanked, row kept so replies keep their anchor. */
  deletedAt DateTime?

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  author       User   @relation("TeamRunCommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  authorUserId String

  parent   TeamRunComment?  @relation("TeamRunCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  TeamRunComment[] @relation("TeamRunCommentThread")

  /** Plain text, trimmed, max 2000 chars. No markdown — this is not Engineer prose. */
  body String

  @@index([teamId, runId, createdAt])
  @@index([runId])
  @@index([authorUserId])
  @@index([parentId])
}

/** Emails allowed to receive magic-link sign-in (invite list). */
model AuthAllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/** Auth.js / NextAuth â€” OAuth-style account linkage (email magic link uses this). */
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/** Auth.js database sessions (kept for adapter compatibility; app uses JWT sessions in middleware). */
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Short numeric sign-in code, emailed beside the magic link so a driver whose mail app opened
/// the link in the wrong browser can still get in. Deliberately NOT a VerificationToken: six
/// digits is only safe behind the durable `attempts` cap below, and Auth.js's callback is public
/// with no rate limiting we can hook (the middleware matcher excludes `api/auth` wholesale).
model SignInCode {
  id         String   @id @default(cuid())
  /// Normalised (trimmed, lowercased) email — same key space as VerificationToken.identifier.
  identifier String
  /// SHA256(code + AUTH_SECRET). The plaintext code exists only in the email.
  codeHash   String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([expires])
}

enum ActionItemSourceType {
  RUN
  MANUAL
}

enum ActionItemListKind {
  THINGS_TO_TRY
  THINGS_TO_DO
}

model ActionItem {
  id          String               @id @default(cuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  text        String
  normKey     String
  listKind    ActionItemListKind   @default(THINGS_TO_TRY)
  /** User-visible order: lower = earlier in the list. */
  sortOrder   Int                  @default(0)
  sourceType  ActionItemSourceType
  sourceRunId String?
  isCompleted Boolean              @default(false)
  isArchived  Boolean              @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  sourceRun Run? @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)

  @@index([userId, listKind, isArchived, sortOrder])
  @@index([userId, isArchived, createdAt])
  @@index([userId, listKind, normKey, isArchived])
}

/// Global setup sheet model (e.g. Mugen MTC3): parameter schema shared by every car of that chassis
/// across all users. Not user-owned — `userId` is creator attribution only.
model SetupSheetModel {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  name       String
  /// Stable id for aggregation and built-in seeds (e.g. mugen_mtc3, awesomatix_a800rr).
  slug       String
  schemaJson Json
  /// Confirmed/curated catalog entry (admin-managed). User-created models stay false until reviewed.
  isAuthorized Boolean @default(false)
  /// What the chassis races: a `ChassisPlatformId` from `src/lib/cars/carClasses.ts`.
  ///
  /// Asked for, and required, on the driver's create-from-PDF door (2026-08-26). Before that
  /// nothing on a driver-made chassis said what it was: discipline was inferred from
  /// `CHASSIS_PLATFORM_BY_SLUG`, a hardcoded list of twelve curated slugs, so every chassis a
  /// driver derived came back "unknown" forever.
  ///
  /// Nullable, not defaulted: the curated rows still answer from the slug map, and a default
  /// would put every pre-existing row into a discipline nobody chose. `disciplineForCar` reads
  /// the slug map first and falls through to here, so both eras answer.
  discipline String?

  /// Creator (attribution only; models are shared globally). Null for seeded catalog entries.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  cars            Car[]
  baselineSetups  BaselineSetup[]
  setupDocuments  SetupDocument[]
  calibrations    SetupSheetCalibration[]
  setupFillDrafts SetupFillDraft[]
  /// The sheets this chassis draws: the primary blank it was derived/attached from, plus any
  /// EDITIONS — rebuilt PDFs of the same sheet with renamed boxes (isEdition = true). One car,
  /// several papers; the primary is the row with isEdition = false.
  sheetBlanks SetupSheetBlank[]
  /** PDF calibration used for auto-pick and the car-page â€œEdit PDF calibrationâ€ link. */
  defaultCalibrationId String?                @unique
  defaultCalibration   SetupSheetCalibration? @relation("ModelDefaultCalibration", fields: [defaultCalibrationId], references: [id], onDelete: SetNull)

  @@unique([slug])
  @@index([userId, updatedAt])
}

/**
 * One blank manufacturer setup sheet somebody uploaded, and what was read off it.
 *
 * WHY THIS IS ITS OWN TABLE. The obvious homes both destroy the data on the next ordinary save:
 * `SetupSheetCalibration.calibrationDataJson` is rebuilt by `normalizeCalibrationData`, and
 * `SetupSheetModel.schemaJson` by `parseSetupSheetModelSchema`. Both are whitelists, so anything
 * they do not recognise disappears the first time an admin edits a calibration or names a box —
 * which is precisely when the founder is working on this chassis. A refused flat PDF also has no
 * chassis row to hang off at all.
 *
 * WHY EVERY LINK IS SetNull. `boxesJson` is what the fill surface needs to draw the sheet, and the
 * chassis is global — other drivers are on it. If the original uploader deletes their account, the
 * `SetupDocument` cascade takes their PDF with them, and re-deriving from the file stops being
 * possible. So the geometry is stored here rather than read back from the PDF on demand, and
 * nothing about this row cascades: the sheet keeps working for everyone else, and the founder's
 * review queue keeps the upload.
 */
model SetupSheetBlank {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// FILLABLE | NOT_FILLABLE | UNREADABLE. Refusals are kept so the founder can follow them up.
  status String
  /// driver | admin — which door this came in through.
  source String @default("driver")

  /// Null when the upload was refused: there is no chassis, only a file and a name.
  /// NOT unique since 2026-08-16: a chassis holds one PRIMARY blank (isEdition = false) plus any
  /// number of rebuilt EDITIONS of the same sheet. See `sheetBlankResolve.ts`.
  setupSheetModel   SetupSheetModel? @relation(fields: [setupSheetModelId], references: [id], onDelete: SetNull)
  setupSheetModelId String?

  /// A rebuilt copy of a sheet the chassis already has: same car, same printed layout, every box
  /// renamed by whoever rebuilt the PDF. Editions carry their own boxes, their own field list
  /// (`schemaFieldsJson`) and their own page images; the model's schema stays canonical.
  isEdition Boolean @default(false)
  /// SetupSheetModelFieldDef[] for an edition's own boxes. The model's schemaJson deliberately does
  /// NOT grow these keys - an edition's vocabulary is its own until a human aliases it.
  schemaFieldsJson Json?
  /// `derivedSheetFingerprint` of what the derivation produced, so a second driver uploading the
  /// same rebuilt PDF joins this edition instead of minting a twin.
  fingerprint String?

  /// The stored PDF, as a normal SetupDocument named "BLANK - <name>". Goes with its uploader.
  setupDocument   SetupDocument? @relation("SetupSheetBlankDocument", fields: [setupDocumentId], references: [id], onDelete: SetNull)
  setupDocumentId String?        @unique

  uploadedBy       User?   @relation("SetupSheetBlankUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByUserId String?

  /// What the driver typed, and its normalized form so the duplicates view can group on it.
  chassisNameTyped String
  normalizedName   String

  pageCount Int @default(1)
  /// DerivedBox[] - page, fractional rect and draw style per schema key. The fill surface reads this.
  boxesJson Json?
  /// DerivedSheetStats, so a re-derivation can be compared against what this sheet produced.
  statsJson Json?
  /// Record<schemaKey, PdfFormFieldMappingRule> for boxes the CALIBRATION does not name - the
  /// printed boxes a curated chassis prints but nobody named. Deliberately not in the calibration's
  /// own `formFieldMappings`: values read through that map are finished by the Awesomatix
  /// canonical-key rewrites, and a derived key like `text91` lands straight in one of them. These
  /// are read with `readDerivedSheetValues` instead. See `unionDerivedWithCalibration.ts`.
  derivedMappingsJson Json?
  /// page number -> storage ref for the cached page image.
  pageImagesJson Json?
  /// Names a driver volunteered for a box. Never applied to the shared schema automatically -
  /// naming is the founder's job, and one driver must not relabel a chassis everyone else uses.
  boxNameSuggestionsJson Json?

  /// sheet | form - which surface this chassis fills on. Flipped by an admin once boxes are named,
  /// deliberately, so nobody's fill surface changes underneath them mid-season.
  fillSurface String @default("sheet")

  reviewedAt DateTime?

  @@index([status, reviewedAt, createdAt])
  @@index([normalizedName])
  @@index([setupSheetModelId, isEdition])
}

/**
 * Where an authored baseline came from.
 *  KIT  — how the manufacturer says to build the car out of the box.
 *  BASE — a manufacturer-released "base" sheet, usually written by one of their drivers.
 *  PRO  — any other setup an admin publishes (team car, event-winning sheet).
 */
enum BaselineSetupKind {
  KIT
  BASE
  PRO
}

/**
 * A named, admin-authored setup published against a chassis type — global, visible to every driver,
 * never owned by one. Drivers adopt one by copying it into their own car library
 * (`SetupSnapshot.sourceBaseline`); the copy is frozen at copy time, so editing or deleting a
 * baseline never rewrites anyone's saved setup.
 *
 * `data` is stored in `SetupSnapshot.data` shape (through `normalizeSetupSnapshotForStorage`) so
 * every existing setup reader — sheet view, compare, the Engineer's spread — consumes it unchanged.
 *
 * These are authored sheets, not measured data: they must never reach a community aggregation.
 * Nothing here feeds one, because both rebuilds iterate runs/documents and a baseline has neither.
 */
model BaselineSetup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  setupSheetModel   SetupSheetModel @relation(fields: [setupSheetModelId], references: [id], onDelete: Cascade)
  setupSheetModelId String

  name  String
  kind  BaselineSetupKind @default(PRO)
  notes String?           @db.Text

  /// Optional context tags, same vocabulary as the community buckets: asphalt | carpet.
  surface String?
  /// Optional context tag: low | medium | high.
  gripLevel String?

  /// Setup values, `SetupSnapshot.data` shape.
  data Json

  /// Publishing admin (attribution only; baselines are global). Null once that account is gone.
  createdBy   User?   @relation("BaselineSetupCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?

  copies SetupSnapshot[] @relation("SetupSnapshotSourceBaseline")

  @@index([setupSheetModelId, kind])
}

/**
 * An unfinished sequential setup fill — the one-question-at-a-time flow's state, parked on the
 * server so cancel / back-swipe / refresh / phone-lock stop costing 40 answers.
 *
 * Deliberately its own table rather than a flag on `SetupSnapshot` (founder call 2026-08-02): a
 * half-filled sheet must be structurally incapable of reaching the Engineer's prompt builders, the
 * community aggregations, or a car's setup library. Because it lives here, *zero* existing read
 * sites need a draft filter — the guarantee is in the schema, not in every query that ever gets
 * written against setups.
 *
 * One draft per subject, and the subject is exactly one of:
 *   - `carId`             — a driver filling a new library setup on their car
 *   - `setupSheetModelId` — an admin authoring a global baseline for a chassis
 *
 * The two `@@unique`s look like they would fight each other; they don't. Postgres treats NULLs as
 * distinct in a unique index, so each constraint only ever binds the rows whose own subject column
 * is non-null: driver rows are policed by the first, admin rows by the second, and neither sees the
 * other. (The "exactly one is set" half is a CHECK constraint in the migration — Prisma has no
 * syntax for it.)
 */
model SetupFillDraft {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// Driver subject. Cascade, not SetNull as on `SetupSnapshot.carId`: a snapshot is history and
  /// outlives its car, an unfinished action does not.
  car    Car?    @relation(fields: [carId], references: [id], onDelete: Cascade)
  carId  String?

  /// Admin subject, for baseline authoring.
  setupSheetModel   SetupSheetModel? @relation(fields: [setupSheetModelId], references: [id], onDelete: Cascade)
  setupSheetModelId String?

  /// Answers so far, `SetupSnapshot.data` shape (written through `normalizeSetupSnapshotForStorage`,
  /// so promoting a draft to a real setup is a straight copy with no second normalisation pass).
  data Json

  /// Question the driver was on. Clamped on restore: a schema change can leave it past the end.
  stepIndex Int @default(0)

  /// Raw, uncommitted text in the current text/number step. `commitPendingText` only fires on
  /// advance or blur, so without this a phone-lock mid-question loses the keystrokes and the resume
  /// lands on an empty box — which reads as the app eating your input, the exact failure being fixed.
  pendingText String?

  /// Step key `pendingText` belongs to. Guards against a schema change moving that index onto a
  /// different question; on mismatch the text is dropped rather than pasted somewhere wrong.
  pendingStepKey String?

  /// Setup name typed on the start screen, so Resume doesn't ask for it again.
  name String?

  /// Denormalised progress for the "34 of 68 filled" labels. Display only, and deliberately not
  /// trusted: `/cars/[carId]/setups/new` has the template in hand and recomputes the truth. This
  /// exists so the car page can render its resume row without resolving a chassis schema.
  answeredCount Int @default(0)
  stepCount     Int @default(0)

  /// Template this was filled against. Diagnostics only — never used to invalidate a draft, since
  /// losing 34 answers because an admin added a field is worse than the mismatch.
  templateId String?

  @@unique([userId, carId])
  @@unique([userId, setupSheetModelId])
  @@index([userId, updatedAt])
}

/// Catalog slugs removed by an admin — global seed must not recreate them.
model SetupSheetCatalogSuppression {
  slug         String   @id
  suppressedAt DateTime @default(now())
  suppressedBy String?
}

model Car {
  id                 String   @id @default(cuid())
  name               String
  chassis            String?
  /// Discipline OVERRIDE (ids from src/lib/cars/carClasses.ts, e.g. "touring"). Only consulted
  /// when the chassis catalog cannot place the car - resolve with disciplineForCar(), never by
  /// reading this directly. Drives the log-run car-swap rule (same/unknown discipline keeps the
  /// days tires+prep, different re-derives from the new cars last run), same-class tire
  /// suggestions, and the teammate lap-compare scope. Null = fall back to inference.
  carClass           String?
  notes              String?
  setupSheetTemplate String?  // legacy: "awesomatix_a800rr" | null; prefer setupSheetModelId
  setupSheetModelId  String?
  createdAt          DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  setupSheetModel SetupSheetModel? @relation(fields: [setupSheetModelId], references: [id], onDelete: SetNull)

  runs      Run[]
  snapshots SetupSnapshot[]
  setupDocuments SetupDocument[]
  setupParameterAggregations SetupParameterAggregation[]
  setupFillDrafts            SetupFillDraft[]

  @@index([setupSheetModelId])
  @@index([userId])
}

model Track {
  id        String   @id @default(cuid())
  name      String
  location  String?
  /** GPS pin from â€œmark this locationâ€ when completing a run at the track. */
  latitude  Float?
  longitude Float?
  locationMarkedAt DateTime?
  /** How coordinates were set, e.g. `device`. */
  locationSource String?
  /** LiveRC track root URL (e.g. https://tftr.liverc.com) for session discovery. */
  liveRcUrl String?
  /** MYLAPS Speedhive organization page URL for session discovery. */
  speedhiveUrl String?
  /** Multi-select grip tags (e.g. MEDIUM + HIGH); see `trackMetaTags.ts` ids. */
  gripTags   String[] @default([])
  /** Multi-select layout tags (e.g. TECHNICAL + FAST). */
  layoutTags String[] @default([])
  createdAt DateTime @default(now())
  /**
   * Founder-verified catalog entry. Null = unverified (user-created, live but flagged in the UI).
   * Gates the edit-lock on grip/layout tags (unified catalog rule) and reserves the identity for
   * future community use; grip itself is moving to per-run capture. See docs/ASSET_ACCESS_NORTH_STAR.md.
   */
  verifiedAt DateTime?
  /** ISO-3166-1 alpha-2, lowercase. Scopes the catalog so a driver browses their own country first. */
  countryCode String?
  /** State or province ("CA", "NSW"). Mostly populated for US/AU/CA; null elsewhere by design. */
  region String?
  /**
   * Where a pre-seeded row came from: `liverc` | `osm` | null for user-created.
   * See seeds/track-catalog/README.md. Rows sourced from OpenStreetMap carry an ODbL attribution
   * obligation wherever their coordinates are surfaced.
   */
  catalogSource String?
  /**
   * Identity within that source — a LiveRC host ("1upracing.liverc.com") or an OSM element
   * ("way/12345"). Paired with catalogSource this is the seed importer's idempotency key, which is
   * what makes re-running the import an update rather than a second copy of the catalog.
   */
  catalogSourceRef String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  runs            Run[]
  events          Event[]
  layouts         TrackLayout[]
  favouriteTracks FavouriteTrack[]
  cameraProfiles  TrackCameraProfile[]
  videoAssets     VideoAsset[]
  videoAnalysisJobs VideoAnalysisJob[]
  locationRunPromptDismissals TrackLocationRunPromptDismissal[]

  @@unique([catalogSource, catalogSourceRef])
  @@index([userId])
  @@index([countryCode, name])
}

/**
 * A named physical layout of a track (freeform, user-created). A track can have
 * several (e.g. "Club layout", "Nats config"). Direction (CW/CCW) is chosen per
 * run/event, not stored on the layout. Descriptive only — layouts do NOT change
 * community-aggregation / condition-scope buckets (see trackConditionSignature.ts).
 */
model TrackLayout {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  sortOrder Int      @default(0)
  notes     String?

  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  runs   Run[]
  events Event[]

  @@index([trackId, sortOrder])
  @@index([userId])
}

/** Per-user: do not show the Run-complete GPS modal again for this track. */
model TrackLocationRunPromptDismissal {
  userId      String
  trackId     String
  dismissedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([trackId])
}

model FavouriteTrack {
  userId    String
  trackId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
}

model Event {
  id         String    @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime  @default(now())

  /// Creator (attribution only). Events are global per track/meeting.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  trackId String?

  /** Layout the venue ran for this meeting; runs in the event default to it. */
  trackLayout   TrackLayout? @relation(fields: [trackLayoutId], references: [id], onDelete: SetNull)
  trackLayoutId String?
  /** Preserved when the linked TrackLayout row is deleted. */
  trackLayoutNameSnapshot String?
  /** Optional running direction for the meeting. */
  trackDirection TrackDirection?

  /** Preserved when the linked Track row is deleted. */
  trackNameSnapshot     String?
  trackLocationSnapshot String?
  /** Full track catalog row at unlink/delete time (URLs, tags, GPS, etc.). */
  legacyTrackJson       Json?

  /** LiveRC practice session list URL for this event (optional — often added closer to the date). */
  practiceSourceUrl String?
  /** LiveRC results index URL for this event (optional — often added closer to the date). */
  resultsSourceUrl  String?
  /// This meeting's page on MyRCM — the driver's class page (`/en/report/<event>/<class>`) where
  /// possible, else the event page.
  ///
  /// A destination, never a source. `myrcm.ch` is on the fetch denylist (2026-08-26) so nothing
  /// in the app may request this URL; it exists so the lap importer's PDF door can hand the
  /// driver a link to *tap*, landing them on their own class instead of MyRCM's front page.
  /// Deliberately not folded into `resultsSourceUrl`: that field means "a page we scan", and
  /// every reader of it fetches. See `lapUrlParsers/myRcmUrl.classifyMyRcmEventLink`.
  myRcmUrl          String?
  /** Race class to watch on results index (e.g. \"17.5 Stock\"). */
  raceClass         String?

  /** Watermark for practice auto-import (canonical session completion instant). */
  practiceLastSeenSessionCompletedAt DateTime?
  /** Watermark for results auto-import. */
  resultsLastSeenSessionCompletedAt    DateTime?

  participations EventParticipation[]
  runs Run[]
  importedLapTimeSessions ImportedLapTimeSession[]
  // Future: timetable/scheduled sessions (timetableSessions?), reminders, "most likely session" suggestions

  // NOTE: partial UNIQUE(trackId, resultsSourceUrl) WHERE resultsSourceUrl IS NOT NULL is added in a
  // LATER migration after scripts/dedupe-events.ts collapses duplicate meeting rows.
  @@index([trackId, startDate])
  @@index([trackId, endDate])
  @@index([userId])
  @@index([trackLayoutId])
}

/// Per-user link to a global event (spec tire, notes, dashboard pin).
model EventParticipation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  notes String?
  /** Legacy free-text spec tire label. */
  controlledTireLabel String?
  controlledTireType   TireType? @relation(fields: [controlledTireTypeId], references: [id], onDelete: SetNull)
  controlledTireTypeId String?

  controlledAdditiveType   AdditiveType? @relation(fields: [controlledAdditiveTypeId], references: [id], onDelete: SetNull)
  controlledAdditiveTypeId String?

  /** When set, prefer this event on the dashboard among active meetings. */
  pinnedAt DateTime?

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([controlledTireTypeId])
  @@index([controlledAdditiveTypeId])
}

/** Global tire additive catalog (shared across all users). */
model AdditiveType {
  id          String   @id @default(cuid())
  displayName String
  /** Unique product code — canonical identity. */
  modelCode   String   @unique
  createdAt   DateTime @default(now())
  /**
   * Founder-verified catalog entry. Null = unverified (user-created, live but flagged).
   * Only verified identities feed community aggregations. See docs/ASSET_ACCESS_NORTH_STAR.md.
   */
  verifiedAt  DateTime?

  createdBy   User?   @relation("AdditiveTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?

  runs                 Run[]
  eventParticipations  EventParticipation[]

  @@index([displayName])
  @@index([createdByUserId])
}

/** Global tire product catalog (shared across all users). */
model TireType {
  id          String   @id @default(cuid())
  displayName String
  /** Unique manufacturer/product code — canonical identity. */
  modelCode   String   @unique
  createdAt   DateTime @default(now())
  /**
   * Founder-verified catalog entry. Null = unverified (user-created, live but flagged).
   * Only verified identities feed community aggregations. See docs/ASSET_ACCESS_NORTH_STAR.md.
   */
  verifiedAt  DateTime?

  /**
   * Catalog attributes (AI pre-seed enrichment, TC touring first — see ASSET_ACCESS_NORTH_STAR.md).
   * All nullable: legacy/user-created and non-touring rows leave them empty.
   * surface = "asphalt" | "carpet" | "both" | "unknown"; tireType = "rubber" | "foam".
   */
  discipline  String?
  brand       String?
  model       String?
  compound    String?
  surface     String?
  tireType    String?
  /** Provenance for founder review of pre-seeded rows. */
  sourceUrl   String?
  productUrl  String?

  createdBy   User?   @relation("TireTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?

  tireSets  TireSet[]
  runs      Run[]
  eventParticipations EventParticipation[]

  @@index([displayName])
  @@index([createdByUserId])
  @@index([discipline])
}

model TireSet {
  id         String   @id @default(cuid())
  /** Denormalized display label; legacy rows may use this without tireTypeId. */
  label      String
  setNumber  Int      @default(1) // internal per-compound counter (max+1 on create) — never shown as identity
  initialRunCount Int @default(0) // optional starting run count (usually 0)
  /** Optional insert (e.g. medium soft). */
  insertLabel String?
  /** Optional wheel type. */
  wheelLabel  String?
  /** Optional specific product model for this physical set (e.g. premount SKU). */
  specificModel String?
  /** Optional physical mark the driver writes on the sidewall (or race-control mark).
      Short free text (≤4 chars, trimmed). Repeats freely across compounds/events → NOT unique. */
  mark       String?
  notes      String?
  createdAt  DateTime @default(now())
  /** Soft delete: hidden from pickers/lists but kept so linked run history stays intact. */
  archivedAt DateTime?

  tireType   TireType? @relation(fields: [tireTypeId], references: [id], onDelete: SetNull)
  tireTypeId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  runs Run[]

  @@index([userId, tireTypeId, setNumber])
}

/** Reusable battery pack; run counts mirror TireSet (global per pack, linked via Run). */
model Battery {
  id              String   @id @default(cuid())
  label           String
  packNumber      Int      @default(1)
  initialRunCount Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  /** Soft delete: hidden from pickers/lists but kept so linked run history stays intact. */
  archivedAt      DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  runs Run[]

  @@index([userId])
}

model SetupSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  car   Car?  @relation(fields: [carId], references: [id], onDelete: SetNull)
  carId String?

  // Flexible JSON blob with setup parameters (geometry, shocks, diff, etc.)
  data Json

  /**
   * Named, reusable setup in the car's library ("X4 — high grip carpet"). Null for the per-run
   * snapshots every logged run creates — those stay anonymous history.
   */
  name String?

  /**
   * True only for library setups (created from the car page, never attached to a run directly).
   * Aggregations read snapshots *through runs*, so library rows can never enter the community pool.
   */
  isLibrary Boolean @default(false)

  /** Optional baseline snapshot this row was merged from (audit only; data is always full resolved). */
  baseSetupSnapshotId String?
  baseSetupSnapshot   SetupSnapshot?  @relation("SetupSnapshotBaseline", fields: [baseSetupSnapshotId], references: [id], onDelete: SetNull)
  derivedSnapshots    SetupSnapshot[] @relation("SetupSnapshotBaseline")

  /** Keys that differed from baseSetupSnapshot after merge (audit). */
  setupDeltaJson Json?

  /**
   * The global baseline this was copied from, when it was ("Save a copy" on the car page).
   * `SetNull` on purpose: the copy is the driver's own setup and outlives the baseline.
   */
  sourceBaseline   BaselineSetup? @relation("SetupSnapshotSourceBaseline", fields: [sourceBaselineId], references: [id], onDelete: SetNull)
  sourceBaselineId String?

  /** Filled PDF from base template + calibration (same pipeline as runs); see `SETUP_PDF_RENDER_PIPELINE_VERSION`. */
  renderedSetupPdfPath          String?
  renderedSetupPdfGeneratedAt   DateTime?
  setupPdfRenderVersion         Int      @default(1)

  runs Run[]
  sourceDocuments SetupDocument[] @relation("CreatedSetup")

  @@index([userId])
  @@index([carId])
  @@index([baseSetupSnapshotId])
  @@index([carId, isLibrary])
  @@index([sourceBaselineId])
}

enum SetupDocumentSourceType {
  PDF
  IMAGE
}

enum SetupDocumentParseStatus {
  PENDING
  PARSED
  PARTIAL
  FAILED
}

enum SetupDocumentImportStatus {
  PENDING
  PROCESSING
  FAILED
  COMPLETED
  COMPLETED_WITH_WARNINGS
}

enum SetupDocumentImportOutcome {
  COMPLETED_TRUSTED
  COMPLETED_WITH_WARNINGS
  PARTIAL_DIAGNOSTIC
  FAILED
}

/**
 * CAR_PARAMETER: all eligible snapshots per car (scopeKey = carId).
 * CAR_PARAMETER_CONDITION: runs bucketed by track grip/layout signature (scopeKey = encoded condition).
 */
enum SetupAggregationScopeType {
  CAR_PARAMETER
  CAR_PARAMETER_CONDITION
}

enum SetupAggregationValueType {
  NUMERIC
  CATEGORICAL
  BOOLEAN
  MULTI_SELECT
}

/**
 * Materialized stats from normalized SetupSnapshot.data (via SetupDocument.createdSetup).
 * No document ids, filenames, or user ids â€” scoped by carId (user-owned car).
 */
model SetupParameterAggregation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopeType SetupAggregationScopeType @default(CAR_PARAMETER)
  scopeKey  String
  carId     String
  car       Car     @relation(fields: [carId], references: [id], onDelete: Cascade)

  parameterKey String
  valueType    SetupAggregationValueType

  sampleCount Int

  numericStatsJson     Json?
  categoricalStatsJson Json?

  @@unique([scopeType, scopeKey, carId, parameterKey])
  @@index([carId])
}

/**
 * App-wide parameter stats from every user's setup uploads flagged `eligibleForAggregationDataset`,
 * grouped by `Car.setupSheetTemplate` (same keys as CAR_PARAMETER, no per-user isolation).
 */
model CommunitySetupParameterAggregation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /** Matches `Car.setupSheetTemplate` (e.g. awesomatix_a800rr). */
  setupSheetTemplate String
  /** Parsed setup surface bucket (asphalt | carpet). */
  trackSurface String
  /**
   * Grip-level bucket derived from the doc's `traction` multi-select tag.
   * Values: `any` (always emitted â€” all eligible docs for the surface),
   * `low` / `medium` / `high` (one row per grip tag the doc claims; multi-tag docs land in multiple buckets).
   */
  gripLevel String @default("any")

  parameterKey String
  valueType    SetupAggregationValueType

  sampleCount Int

  numericStatsJson     Json?
  categoricalStatsJson Json?

  @@unique([setupSheetTemplate, trackSurface, gripLevel, parameterKey])
  @@index([setupSheetTemplate, trackSurface, gripLevel])
}

/**
 * Manufacturer baseline for a setup sheet (official PDF + optional summary).
 * One row per `setupSheetTemplate`; not counted in community aggregation sample stats.
 */
model SetupSheetManufacturerBaseline {
  setupSheetTemplate String @id
  /** Official manufacturer PDF URL (https recommended). */
  pdfUrl    String   @db.Text
  /** Optional short notes for the Engineer when the PDF is not parsed into rows. */
  summary   String?  @db.Text
  /** Last admin confirmation that pdfUrl/summary still match the current kit doc. */
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** User review for dataset / aggregation eligibility (bulk import workflow). */
enum SetupImportDatasetReviewStatus {
  UNSET
  NOT_CONFIRMED
  CONFIRMED_ACCURATE
}

/**
 * Bulk setup PDF import: label + files first; calibration and parse are per SetupDocument.
 */
model SetupImportBatch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String?
  /** Optional batch default for future UX; not required for create/parse (per-document calibration is canonical). */
  calibrationProfileId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  calibrationProfile SetupSheetCalibration? @relation(fields: [calibrationProfileId], references: [id], onDelete: SetNull)
  documents          SetupDocument[]

  @@index([userId, createdAt])
  @@index([calibrationProfileId])
}

model SetupDocument {
  id               String                   @id @default(cuid())
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  originalFilename String
  storagePath      String
  mimeType         String
  sourceType       SetupDocumentSourceType
  parserType       String?
  parseStatus      SetupDocumentParseStatus @default(PENDING)
  importStatus     SetupDocumentImportStatus @default(PENDING)
  importOutcome    SetupDocumentImportOutcome?
  currentStage       String?
  lastCompletedStage String?
  stageStartedAt      DateTime?
  stageFinishedAt     DateTime?
  importDebugLogJson  Json?
  importDiagnosticJson Json?
  importErrorMessage String?
  parseStartedAt     DateTime?
  parseFinishedAt    DateTime?
  calibrationResolvedProfileId String?
  calibrationResolvedSource    String?
  calibrationResolvedDebug     String?
  calibrationUsedIsForcedDefault Boolean?
  extractedText    String?
  parsedDataJson   Json?
  /** Original source URL when imported from a remote site (e.g. PetitRC). */
  sourceUrl        String?
  /** Optional source tag (e.g. \"petitrc\"). */
  sourceSite       String?
  /** SHA-256 of the original PDF bytes (dedupe across URL variants and old imports). */
  sourceContentSha256 String?
  /** User corrected structured fields after parse (niche fixes; automated re-parse clears this). */
  parsedSetupManuallyEdited Boolean @default(false)
  /** Sticky calibration used for parse + render (forced default when missing). */
  calibrationProfileId String?
  calibrationProfile   SetupSheetCalibration? @relation("SetupDocumentCalibration", fields: [calibrationProfileId], references: [id], onDelete: SetNull)
  /** Calibration id actually used to produce current parsedDataJson (stale detection). */
  parsedCalibrationProfileId String?
  parsedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  car   Car?  @relation(fields: [carId], references: [id], onDelete: SetNull)
  carId String?
  /// Canonical `Car.setupSheetTemplate` (e.g. awesomatix_a800rr). Legacy; prefer setupSheetModelId.
  setupSheetTemplate String?
  setupSheetModelId  String?
  setupSheetModel    SetupSheetModel? @relation(fields: [setupSheetModelId], references: [id], onDelete: SetNull)

  setupImportBatchId String?
  setupImportBatch   SetupImportBatch? @relation(fields: [setupImportBatchId], references: [id], onDelete: Cascade)
  importDatasetReviewStatus    SetupImportDatasetReviewStatus @default(UNSET)
  /** True only when user confirmed accurate and parse succeeded (PARSED/PARTIAL). */
  eligibleForAggregationDataset Boolean @default(false)

  createdSetup   SetupSnapshot? @relation("CreatedSetup", fields: [createdSetupId], references: [id], onDelete: SetNull)
  createdSetupId String?
  exampleForCalibrations SetupSheetCalibration[] @relation("CalibrationExampleDocument")
  /// Set when this document is a blank manufacturer sheet a chassis was derived from.
  blankSheet SetupSheetBlank? @relation("SetupSheetBlankDocument")
  runsUsingAsPdfSource Run[] @relation("RunSetupPdfSource")

  @@index([userId, createdAt])
  @@index([userId, parseStatus])
  @@index([userId, setupSheetTemplate])
  @@index([userId, setupSheetModelId])
  @@index([setupSheetModelId])
  @@index([setupImportBatchId])
  @@index([carId])
  @@index([createdSetupId])
  @@index([calibrationProfileId])
  @@unique([userId, sourceUrl])
  @@unique([userId, sourceContentSha256])
}

model SetupSheetCalibration {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name String
  sourceType String
  calibrationDataJson Json
  exampleDocumentId String?
  setupSheetModelId String?
  /**
   * Legacy flag from the community-shared top-3 promotion; calibrations are globally visible
   * regardless of this field while global mode is enabled.
   */
  communityShared Boolean @default(false)
  /**
   * Founder-verified calibration. Null = unverified: usable by its creator, but never
   * offered to OTHER users by auto-pick until verified. See docs/ASSET_ACCESS_NORTH_STAR.md.
   */
  verifiedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  setupSheetModel SetupSheetModel? @relation(fields: [setupSheetModelId], references: [id], onDelete: SetNull)
  defaultForModel SetupSheetModel? @relation("ModelDefaultCalibration")
  exampleDocument SetupDocument? @relation("CalibrationExampleDocument", fields: [exampleDocumentId], references: [id], onDelete: SetNull)
  runsUsingCalibration Run[] @relation("RunSetupPdfCalibration")
  documentsUsingCalibration SetupDocument[] @relation("SetupDocumentCalibration")
  setupImportBatches        SetupImportBatch[]

  @@index([userId, createdAt])
  @@index([userId, setupSheetModelId])
  @@index([setupSheetModelId])
  @@index([communityShared, createdAt])
  @@index([exampleDocumentId])
}

enum SessionType {
  TESTING
  PRACTICE
  RACE_MEETING
}

/** Optional running direction for a track layout (clockwise / counter-clockwise). */
enum TrackDirection {
  CW
  CCW
}

model Run {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  sessionLabel         String?  // Optional free-text; for Race Meeting used as override/additional only
  sessionType          SessionType  @default(TESTING)
  meetingSessionType   String?   // PRACTICE | SEEDING | QUALIFYING | RACE (only when sessionType = RACE_MEETING)
  meetingSessionCode   String?   // e.g. "1","2","3" for Practice/Race; "Q1","Q2","Q3" for Qualifying; enables timetableSessionId later
  carNameSnapshot      String?
  trackNameSnapshot    String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  car   Car?  @relation(fields: [carId], references: [id], onDelete: SetNull)
  carId String?

  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)
  trackId String?

  /** Named layout ran this session (descriptive; not part of aggregation buckets). */
  trackLayout   TrackLayout? @relation(fields: [trackLayoutId], references: [id], onDelete: SetNull)
  trackLayoutId String?
  /** Preserved when the linked TrackLayout row is deleted (mirrors trackNameSnapshot). */
  trackLayoutNameSnapshot String?
  /** Optional running direction for this session. */
  trackDirection TrackDirection?
  /**
   * Grip level for THIS session — one of TRACK_GRIP_TAG_IDS (VERY_LOW…VERY_HIGH).
   *
   * Track.gripTags describes the venue in general; grip genuinely moves through a day as
   * rubber goes down and temperature changes, so a run wants its own. Added 2026-08-04
   * after the Engineer's "nearest comparable run" search proved blunt: with grip read off
   * the track, every run at a venue matched every other run there perfectly, and two of the
   * three similarity axes collapsed into "same track".
   *
   * DORMANT — NOTHING WRITES THIS. The capture control was pulled the next day to keep the
   * log-run form lean for the launch push; the column stayed because it is already migrated
   * and costs nothing empty. `resolveGripTags` falls back to Track.gripTags, so comparable-run
   * scoring works exactly as it did before, just without a per-session signal.
   *
   * Deliberately NOT auto-filled from the track baseline while there is no control: that
   * would be indistinguishable from a driver's own judgement, and null is the honest state.
   * When grip capture returns, null still means "not recorded".
   */
  gripLevel String?

  event   Event?  @relation(fields: [eventId], references: [id])
  eventId String?

  /** Session race class when not from event, or override (e.g. \"17.5 Stock\"). */
  raceClass String?

  /**
   * Dormant since the tire-counter rework (2026-07-26): tires are defined by how
   * many runs are on them, not by a named set. Kept unread so existing history
   * stays intact — same treatment `Car.carClass` got. Nothing writes this.
   */
  tireSet   TireSet? @relation(fields: [tireSetId], references: [id])
  tireSetId String?

  /** The compound on the car for this run — picked directly, no longer reached via a set. */
  tireType   TireType? @relation(fields: [tireTypeId], references: [id], onDelete: SetNull)
  tireTypeId String?

  /** Runs on the rubber currently fitted; 1 = first run on it. Carried forward from the car's last run. */
  tireRunNumber Int      @default(1)

  /**
   * Groups runs sharing one continuous life of rubber. A new id is minted whenever
   * the driver says the tires changed ("brand new", an explicit count, or "not sure").
   * The wear chains group on this — it replaces `tireSetId` as the stint key.
   */
  tireStintId String?

  /**
   * False when the driver said "not sure how many runs" — e.g. a set they were given.
   * `tireRunNumber` is then relative to when they got them, not absolute tire age, so
   * k→k+1 deltas still chain but anything anchored to absolute position must exclude these.
   */
  tireAgeKnown Boolean @default(true)

  additiveType   AdditiveType? @relation(fields: [additiveTypeId], references: [id], onDelete: SetNull)
  additiveTypeId String?

  /**
   * Legacy single "warmer timing" in minutes. Superseded by `tirePrep` (the
   * ordered application sequence); kept in sync as a derived total (sum of
   * warmer-step minutes) so older read surfaces + aggregations keep working.
   */
  warmerTimingMinutes Int?

  /**
   * Ordered tire-prep applications toward the run — see `src/lib/runs/tirePrep.ts`.
   * Each step: { appliedAdditive, minutes, warmers, towels, temperatureC }.
   * Null on runs logged before the sequence model (synthesize from
   * `warmerTimingMinutes` on read).
   */
  tirePrep Json?

  battery   Battery? @relation(fields: [batteryId], references: [id])
  batteryId String?

  batteryRunNumber Int @default(1)

  setupSnapshot   SetupSnapshot @relation(fields: [setupSnapshotId], references: [id])
  setupSnapshotId String

  /** Base uploaded PDF used to render this runâ€™s setup sheet (derived PDF is separate). */
  sourceSetupDocumentId String?
  sourceSetupDocument   SetupDocument? @relation("RunSetupPdfSource", fields: [sourceSetupDocumentId], references: [id], onDelete: SetNull)
  /** Calibration / mapping profile used with the base PDF. */
  sourceSetupCalibrationId String?
  sourceSetupCalibration   SetupSheetCalibration? @relation("RunSetupPdfCalibration", fields: [sourceSetupCalibrationId], references: [id], onDelete: SetNull)
  /** Relative path under public/ for rendered run setup PDF (same bytes as in-app view). */
  renderedSetupPdfPath      String?
  renderedSetupPdfGeneratedAt DateTime?
  /** Increment when render pipeline changes; triggers re-render when mismatched. */
  setupPdfRenderVersion     Int      @default(1)

  // Store raw lap times as JSON array (SQLite-compatible; was Float[] for PostgreSQL).
  // Primary (self) laps â€” kept in sync with lapSession.entries[primary] when lapSession is set.
  lapTimes Json @default("[]")

  // Structured lap ingestion: source, metrics, multi-driver/field-ready entries (see src/lib/lapSession/types.ts).
  lapSession Json?

  /**
   * Materialized lap summary metrics computed from `lapTimes` / `lapSession` at
   * save time. List views (Sessions / dashboard) read these instead of
   * recomputing from the JSON lap arrays for every row. Nullable for legacy
   * runs written before the column existed â€” callers fall back to computing
   * from the lap arrays in that case.
   */
  bestLapSeconds   Float?
  avgTop5LapSeconds Float?

  notes            String?  // unified notes (new); legacy fields below for older runs
  driverNotes      String?
  handlingProblems String?
  /** Optional structured handling tags / balance / prompts (see runHandlingAssessment). */
  handlingAssessmentJson Json?
  /**
   * Required 1â€“10 overall car rating captured at "Run complete". Nullable in DB so legacy and
   * draft runs aren't broken, but the run-complete API path enforces it. Drives the
   * Engineer's `runQuality` signal + known-good / known-bad history mining.
   */
  carRating Int?
  suggestedChanges String?
  /** Preâ€“next-run reminders; same bullet format as `suggestedChanges` (ActionItem `THINGS_TO_DO`). */
  suggestedPreRun  String?
  appliedChanges   String?

  importedLapSets RunImportedLapSet[]
  actionItems     ActionItem[]

  /** Lap-time imports linked to this run (optional; see ImportedLapTimeSession). */
  linkedImportedLapSessions ImportedLapTimeSession[] @relation("ImportedLapSessionLinkedRun")

  /** Primary imported lap-time session when this run was created from detection / URL import. */
  importedLapTimeSessionId String?                 @unique
  detectedImportedLapSession ImportedLapTimeSession? @relation("RunDetectedImport", fields: [importedLapTimeSessionId], references: [id], onDelete: SetNull)

  /**
   * When the on-track session actually occurred (from timing import / LiveRC), if known.
   * Distinct from createdAt (when this row was saved in the app).
   */
  sessionCompletedAt DateTime?
  /** User finished the logging workflow (Run completed), or saved from event-detected import. */
  loggingComplete  Boolean  @default(false)
  /**
   * First server time when this run was saved with `loggingComplete` true (non-draft).
   * Immutable after set. Used for list timestamps so they stay on â€œwhen I finished loggingâ€
   * rather than re-imported session wall clock.
   *
   * Legacy completed rows may still be null; display falls back to `sessionCompletedAt` then
   * `createdAt`. Optional one-shot SQL: set to COALESCE(session_completed_at, created_at)
   * where logging_complete and logging_completed_at is null.
   */
  loggingCompletedAt DateTime?
  /** Dashboard / import chooser: hide "incomplete logging" reminder without deleting the run. */
  incompleteLoggingPromptDismissedAt DateTime?
  /**
   * Sessions list: hide the "no lap times — import them" warning on this run without
   * deleting it. Deliberately NOT `incompleteLoggingPromptDismissedAt` — that column
   * drives the dashboard's "Runs not finished logging" list, and sharing it would make
   * silencing a lap warning silently drop the run out of that list too.
   */
  lapImportPromptDismissedAt DateTime?

  /**
   * Stable ordering axis for run lists. Stamped once at create time (= server `now()`)
   * and never auto-updated. Only changes when the user explicitly drags a run to a new
   * position (reorder endpoint) or opts in to "use session time". Display time-of-day
   * is independent (see `sessionCompletedAt` / `createdAt`); this column exists purely
   * so "if B was completed after A, B stays above A forever" holds regardless of edits,
   * re-imports, or lap-time changes. Backfilled from `COALESCE(sessionCompletedAt, createdAt)`.
   */
  sortAt DateTime @default(now())

  /**
   * IANA zone of the device that logged this run (`rc_tz` cookie at create time).
   *
   * Session grouping asks "what calendar day was this run, to the driver?" — NOT to
   * whoever happens to be reading. Keyed on the reader's zone, a teammate's continuous
   * test day splits into two dated groups the moment it crosses the reader's midnight
   * (reported 2026-08-09: one MR33 Arena test day appearing as 06 + 07 Aug). Stamped
   * once at create and never rewritten; an edit months later must not relabel the day
   * the driver was actually there.
   *
   * Null on runs logged before this column existed — `resolveRunLocalTimeZone` falls
   * back to the owner's `User.timeZone`, then the viewer's zone.
   */
  localTimeZone String?

  /**
   * When false, team members do not see this run in team Sessions or any Engineer peer path.
   * Team membership is now the only route to another user's runs, so this flag is absolute:
   * there is no longer a link type that bypasses it.
   */
  shareWithTeam Boolean @default(true)

  /** Cached deterministic Engineer Summary JSON (invalidated on run update). */
  engineerSummaryJson         Json?
  engineerSummaryRefRunId     String?
  engineerSummaryComputedAt   DateTime?
  /** Optional structured Deep Dive answers (versioned object). */
  engineerDeepDiveJson        Json?

  /**
   * Optional URL to the practice day results page (e.g. LiveRC practice day)
   * that the Lap Times "url" ingest tab uses to list candidate sessions for this
   * driver. Captured per-run (vs the user-wide `currentPracticeDayUrl` setting)
   * so historical runs remember which day they came from even when the user
   * moves on to a new day.
   */
  practiceDayUrl String?

  /**
   * Weather / conditions captured for this session. Auto-fetched from the track's
   * pinned coordinates (else device location) at the session's actual time via
   * Open-Meteo, then user-editable. Stored canonical metric (°C, %, km/h). All
   * nullable: indoor runs, pre-feature runs, and drafts may omit them.
   * `conditionsAirTempC` powers the Engineer's condition context + the
   * temperature-band axis of CAR_PARAMETER_CONDITION aggregations.
   */
  conditionsAirTempC     Float?
  /** Manual track/surface-temp probe reading — never from the weather API. */
  conditionsTrackTempC   Float?
  conditionsCloudCoverPct Int?
  /** WMO weather interpretation code (0 clear … 3 overcast … 95 thunderstorm). */
  conditionsWeatherCode  Int?
  conditionsHumidityPct  Int?
  conditionsWindKph      Float?
  conditionsWindDirDeg   Int?
  /** Provenance: `open-meteo-forecast` | `open-meteo-archive` | `manual`. */
  conditionsSource       String?
  conditionsLatitude     Float?
  conditionsLongitude    Float?
  /** The instant the weather reading represents (hour bucket at the session time). */
  conditionsObservedAt   DateTime?

  betweenRunHint EngineerBetweenRunHint?
  dashboardSuggestion EngineerDashboardSuggestion?

  videoAnalysisJobs VideoAnalysisJob[]
  videoAssets         VideoAsset[]
  teamComments        TeamRunComment[]

  @@index([userId, sortAt])
  @@index([userId, carId, carRating])
  @@index([carId])
  @@index([trackId])
  @@index([trackLayoutId])
  @@index([eventId])
  @@index([tireSetId])
  @@index([userId, tireStintId])
  @@index([tireTypeId])
  @@index([additiveTypeId])
  @@index([batteryId])
  @@index([setupSnapshotId])
  @@index([sourceSetupDocumentId])
  @@index([sourceSetupCalibrationId])
}

