# =============================================================================
# RC Engineer — environment variables
# Copy to `.env` / `.env.local` and fill values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication (Auth.js / magic link)
# -----------------------------------------------------------------------------

## AUTH_SECRET — required in production. Generate: openssl rand -base64 32
AUTH_SECRET=""

## AUTH_URL — public site URL (e.g. https://your-app.vercel.app). Required for magic-link callbacks.
AUTH_URL="http://localhost:3000"

## AUTH_ALLOWED_EMAILS — comma-separated allowlist synced by `npx prisma db seed` into AuthAllowedEmail.
# Example: AUTH_ALLOWED_EMAILS="you@example.com,teammate@example.com"
AUTH_ALLOWED_EMAILS=""

## AUTH_ADMIN_EMAILS — comma-separated; these signed-in users see Settings → allowlist UI and may add/remove AuthAllowedEmail rows via API.
# AUTH_ADMIN_EMAILS="you@example.com"

## AUTH_DEV_ALLOW_ANY_EMAIL=1 — non-production only: skip allowlist (local dev convenience). Do not set in Vercel Production.
# AUTH_DEV_ALLOW_ANY_EMAIL=1

## AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET — optional Google OAuth. Sign-in without SMTP; allowlist still applies to the Google account email.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web). Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

## EMAIL_SERVER / EMAIL_FROM — Nodemailer SMTP (required on Vercel for inbox magic links). Omit locally to log links to the dev terminal.
# Resend (no custom domain): API key as SMTP password, user "resend", host smtp.resend.com — confirm test From in Resend docs (e.g. onboarding@resend.dev).
# EMAIL_SERVER="smtps://resend:re_xxxxxxxx@smtp.resend.com:465"
# EMAIL_FROM="RC Engineer <onboarding@resend.dev>"
# Other providers:
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="RC Engineer <no-reply@example.com>"

# -----------------------------------------------------------------------------
# REQUIRED for production (Vercel + Neon + Blob)
# -----------------------------------------------------------------------------

## DATABASE_URL (required)
# Postgres connection string. On Neon: Project → Connection string → URI (include `?sslmode=require` if shown).
# Vercel: add to Project → Settings → Environment Variables for Production (and Preview if needed).
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
DATABASE_URL=""
# NOTE: Put DATABASE_URL in `.env.local` (or `.env`). Next.js loads `.env.local` for `next dev`.
# The Prisma CLI does not load `.env.local` by itself. Use `npm run db:migrate:deploy`, `db:push`, etc.
# (they use `npx dotenv-cli -e .env.local`). Or in PowerShell run: `npx dotenv-cli -e .env.local -- prisma ...`

## BLOB_READ_WRITE_TOKEN (required on Vercel for durable PDF storage)
# Vercel Blob read/write token. On Vercel (VERCEL=1), uploads fail fast without this — local disk is not durable in serverless.
# Locally, without this token, PDFs go to `.local-uploads/` (or legacy `public/uploads/` for reads only).
# Dashboard: Storage → Blob → connect project → copy token into env.
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# DEBUG_ACCESS_GATE=1 — log middleware gate decisions in the dev terminal.
# DEBUG_SETUP_UPLOAD_TIMING=1 — log setup-sheet POST phases (formData, Blob put, DB) to find upload latency.
# DEBUG_SETUP_PROCESS_TIMING=1 — log POST /api/setup-documents/[id]/process stages (load, parse, extract, map, DB).
# DEBUG_ENGINEER_CHAT=1 — include error stack traces in /api/engineer/chat JSON (for UI) in production; dev always includes stack when NODE_ENV=development.

## CAPACITOR_SERVER_URL — origin the iOS shell loads (e.g. https://your-app.vercel.app). Used when running `npx cap sync ios`.
# CAPACITOR_SERVER_URL="https://your-app.vercel.app"

## OPENAI_API_KEY — lap times from timing screenshots (Vision). Server-only.
OPENAI_API_KEY=""

## Engineer chat
# Chat model default is gpt-5.6-terra (founder decision 2026-08-01: won blind pairwise vs gpt-5.5
# 3-1-1 on the stripped prompt, at ~1/3 the cost and ~1/2 the latency). Override with ENGINEER_MODEL.
# The between-run hints / dashboard / quick-fix surfaces stay on ENGINEER_DEFAULT_MODEL (gpt-5.5) —
# they call chat/completions directly and were not part of the measurement.
# ENGINEER_NORTH_STAR.md hard rule: no cheap models on the advice path (terra is a frontier tier).
# ENGINEER_MODEL="gpt-5.6-terra"
#
# ENGINEER_API — which OpenAI endpoint the chat tool loop uses. Unset = /v1/responses (default
# since 2026-08-01; REQUIRED for any gpt-5.6-* model — OpenAI rejects those on chat/completions
# whenever function tools are attached). "chat" = the legacy /v1/chat/completions path, only
# usable with a gpt-5.5-or-older ENGINEER_MODEL override.
# ENGINEER_API="chat"
#
# ENGINEER_PROMPT_VARIANT — advice-prompt arm. Unset = the stripped prompt (shipping since
# 2026-08-01, beat the old 74k-char prompt 5-0 in blind founder pairwise). "full" = the old
# prompt, kept for A/Bs. Other values are experiment arms; see advicePromptForVariant().
# ENGINEER_PROMPT_VARIANT="full"
#
# ENGINEER_REASONING_EFFORT — none|minimal|low|medium|high|xhigh|max. gpt-5 family only.
# Only takes effect on ENGINEER_API=responses: on chat/completions an explicit effort cannot be
# combined with function tools, and the chat loop always sends tools. Unset = model default (medium).
# ENGINEER_REASONING_EFFORT="medium"
#
# Max OpenAI 429 retries per completion (default 5): ENGINEER_OPENAI_MAX_RETRIES=5
# Eval batch spacing between cases in ms (default 18000): ENGINEER_EVAL_CASE_DELAY_MS=18000
# Pin the bench/eval user (otherwise it resolves to whoever logged the most recent run — which
# makes a model A/B answer about a different driver's car between arms):
# ENGINEER_EVAL_USER_EMAIL="you@example.com"

## LAP_IMPORT_USER_AGENT — override default fetch user agent for lap URL import.
# LAP_IMPORT_USER_AGENT="MyApp/1.0"

## MYLAPS / Speedhive account link (optional — for “your transponder” session discovery)
# Register an Azure AD B2C app with redirect URI: {AUTH_URL}/api/mylaps/callback
# MYLAPS_OAUTH_CLIENT_ID=""
# MYLAPS_OAUTH_CLIENT_SECRET=""
# MYLAPS_OAUTH_REDIRECT_URI=""
# MYLAPS_OAUTH_POLICY="B2C_1A_signup_signin"

# -----------------------------------------------------------------------------
# Billing / subscriptions (Stripe) — paywall foundation
# -----------------------------------------------------------------------------
# All optional. Unset = billing routes return 503 and the paywall stays fully dark
# (see src/lib/entitlement.ts). Nothing here affects existing users until BILLING_ENFORCED=1.

## STRIPE_SECRET_KEY — Stripe API secret (test key `sk_test_...` first). Dashboard → Developers → API keys.
# STRIPE_SECRET_KEY=""

## STRIPE_WEBHOOK_SECRET — signing secret for the /api/stripe/webhook endpoint.
# Dashboard → Developers → Webhooks → add endpoint {AUTH_URL}/api/stripe/webhook, events:
# checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, invoice.payment_failed.
# Local testing: `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints a whsec_... secret.
# STRIPE_WEBHOOK_SECRET=""

## Price IDs — create Products/Prices in Stripe (Standard $14.99/mo, Pro $24.99/mo AUD, + annual), paste the price_... ids.
# A plan appears on /billing only when its price id is set here (see src/lib/stripe.ts).
# STRIPE_PRICE_STANDARD_MONTHLY=""
# STRIPE_PRICE_STANDARD_ANNUAL=""
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_PRO_ANNUAL=""

## BILLING_ENFORCED=1 — turn the paywall ON. Unset/anything-else = OFF (everyone gets full access).
# Grandfathering: AUTH_ALLOWED_EMAILS / AuthAllowedEmail / AUTH_ADMIN_EMAILS users always resolve to full Pro,
# so existing testers are never walled even when this is 1. Leave OFF until the demo + open signup ship.
# BILLING_ENFORCED=1

## NEXT_PUBLIC_APP_URL — origin for Stripe success/cancel/return URLs when the request Origin header is absent.
# Falls back to the request origin; set explicitly for reliability. e.g. https://your-app.vercel.app
# NEXT_PUBLIC_APP_URL=""
